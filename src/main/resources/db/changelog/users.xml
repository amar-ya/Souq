<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                   http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.8.xsd">

    <changeSet id="a1" author="ammar">
        <createSequence sequenceName="user_seq" startValue="1" incrementBy="1"/>
    </changeSet>

    <changeSet id="Acreate-2" author="ammar">
        <createTable tableName="users">
            <column name="id" type="BIGINT">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="username" type="VARCHAR(255)"/>
            <column name="email" type="VARCHAR(255)"/>
            <column name="pn" type="VARCHAR(255)"/>
            <column name="password" type="VARCHAR(255)"/>
            <column name="role" type="VARCHAR(20)"/>
            <column name="is_verified" type="BOOLEAN"/>
            <column name="created_at" type="TIMESTAMP"/>
        </createTable>
    </changeSet>

    <changeSet id="a3" author="ammar">
        <sql>
            insert into users (id, username, email, password, role, pn, is_verified, created_at) values (nextval('user_seq'), 'admin', 'admin@souq.com', 'hashed_pw', 'ADMIN', '123456', true, NOW());
        </sql>
    </changeSet>
</databaseChangeLog>